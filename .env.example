# AAAX environment template
# cp .env.example .env

SERVER_PORT=8081
SPRING_APPLICATION_NAME=aaax-server

# Public issuer URL (must match how clients reach you)
AAAX_ISSUER=http://localhost:8081

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/aaax
DB_USERNAME=aaax
DB_PASSWORD=aaax

# Redis (optional in v0; reserved)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
