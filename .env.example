# AAAX environment template
# cp .env.example .env

SERVER_PORT=8081
SPRING_APPLICATION_NAME=aaax-server
AAAX_ISSUER=http://localhost:8081
AAAX_JWK_PATH=./data/aaax-jwk.json

# PostgreSQL (Compose)
DB_URL=jdbc:postgresql://localhost:5432/aaax
DB_USERNAME=aaax
DB_PASSWORD=aaax
DB_DRIVER=org.postgresql.Driver

# Redis reserved
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
