# Copy to .env or export before run. Never commit real secrets.

# --- runtime ---
SERVER_PORT=8081
AS_ISSUER=http://localhost:8081
APPLICATION_NAME=AAAX
SYSTEM_INVOKER=AAAX

# --- database (docker compose defaults) ---
DB_URL=jdbc:postgresql://localhost:5432/aaax
DB_USERNAME=aaax
DB_PASSWORD=aaax
# Empty DB first boot: let JPA create tables (liquibase migrations are incremental)
JPA_DDL_AUTO=update
LIQUIBASE_ENABLED=false

# --- redis ---
REDIS_URL=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# --- kafka (optional; leave local dummy if unused) ---
KAFKA_URL=localhost:9092

# --- optional OAuth ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# optional integrations (off)
AAAX_UTIL_ENABLED=false
# KAFKA_CONSUMERS_USER_CREATED_NOTIFICATION=false

# --- keystores (empty = ephemeral RSA; tokens die on restart. Not for production.) ---
# AAAX_JWK_KEYSTORE=
# AAAX_JWK_KEYSTORE_PASSWORD=
# AAAX_JWK_KEYSTORE_ALIAS=
# AAAX_ENCRYPTION_KEYSTORE=
# AAAX_ENCRYPTION_KEYSTORE_PASSWORD=
# AAAX_ENCRYPTION_KEYSTORE_ALIAS=
