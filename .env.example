# AAAX environment template
# cp .env.example .env

SERVER_PORT=8081
SPRING_APPLICATION_NAME=aaax-server
AAAX_ISSUER=http://localhost:8081
AAAX_JWK_PATH=./data/aaax-jwk.json

# PostgreSQL (Compose)
DB_URL=jdbc:postgresql://localhost:5432/aaax
DB_USERNAME=aaax
DB_PASSWORD=aaax
DB_DRIVER=org.postgresql.Driver

# Demo seeds (set false in real deploys / prod profile)
AAAX_DEMO_SEED_CLIENT=true
AAAX_DEMO_SEED_ACCOUNT=true

# OTP: console | mail
AAAX_OTP_CHANNEL=console
AAAX_OTP_MAIL_FROM=noreply@aaax.local
AAAX_OTP_MAIL_SUBJECT=Your AAAX code

# SMTP (when AAAX_OTP_CHANNEL=mail)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Redis reserved
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
